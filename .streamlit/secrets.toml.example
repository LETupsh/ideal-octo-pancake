# ============================================================
# Streamlit Secrets 配置模板（本文件仅作示例，真实密码不要写在这里）
#
# 使用方法：
#   1. 本地运行：复制本文件为同目录下的 secrets.toml 并填入真实值。
#      （secrets.toml 已被 .gitignore 排除，不会被提交）
#   2. Streamlit Cloud：把填好的内容粘贴到
#      对应 App -> Settings（Manage app）-> Secrets 的文本框中保存即可
# ============================================================

# Cookie 加密密钥：请替换为一段至少 32 位的随机字符串
# （该密钥用于加密登录 Cookie，泄露后登录态可被伪造）
cookie_password = "请替换为一段至少32位的随机字符串"

# 登录账号密码：键为账号，值为密码（可按需增删改）
[users]
"账号1" = "密码1"
"账号2" = "密码2"
